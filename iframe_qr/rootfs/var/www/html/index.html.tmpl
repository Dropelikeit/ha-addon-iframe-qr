<!doctype html>
<html>
<head>
<meta charset="utf-8">
<title>Iframe QR Display</title>
<style>
  html, body { margin: 0; height: 100%; overflow: hidden; background: #000; }
  iframe { border: 0; width: 100%; height: 100%; }
  .qr {
    position: fixed;
    right: 16px;
    bottom: 16px;
    z-index: 1000;
    isolation: isolate;
    background: #fff;
    padding: 8px;
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, .3);
    line-height: 0;
  }
  .qr img { display: block; width: ${QR_SIZE}px; height: ${QR_SIZE}px; }

  @property --hue-angle {
    syntax: "<angle>";
    inherits: true;
    initial-value: 0deg;
  }

  .party-frame { display: none; }
  .party-frame.active {
    display: block;
    position: fixed;
    inset: 0;
    z-index: 999;
    pointer-events: none;
    overflow: hidden;
    --hue-angle: 0deg;
    --glow: ${PARTY_GLOW_REACH}px;
    animation: party-spin 8s linear infinite;
  }
  /* dünner Rahmen — unverändert */
  .party-frame.active::before {
    content: "";
    position: absolute;
    inset: 0;
    padding: 3px;
    background: conic-gradient(from var(--hue-angle) in hsl longer hue,
      hsl(0deg 100% 55%), hsl(360deg 100% 55%));
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
            mask-composite: exclude;
  }
  /* Leuchtkegel: derselbe conic-gradient wie der Rand, per Rand-Verlaufsmaske ausgeblendet
     -> Farbe an jeder Position ist per Konstruktion identisch zum Rand, unabhängig vom Seitenverhältnis */
  .party-frame.active::after {
    content: "";
    position: absolute;
    inset: 0;
    opacity: .8;
    background: conic-gradient(from var(--hue-angle) in hsl longer hue,
      hsl(0deg 100% 55%), hsl(360deg 100% 55%));
    -webkit-mask-image:
      linear-gradient(to bottom, black, transparent var(--glow)),
      linear-gradient(to top, black, transparent var(--glow)),
      linear-gradient(to right, black, transparent var(--glow)),
      linear-gradient(to left, black, transparent var(--glow));
    mask-image:
      linear-gradient(to bottom, black, transparent var(--glow)),
      linear-gradient(to top, black, transparent var(--glow)),
      linear-gradient(to right, black, transparent var(--glow)),
      linear-gradient(to left, black, transparent var(--glow));
    -webkit-mask-composite: source-over, source-over, source-over, source-over;
            mask-composite: add, add, add, add;
  }
  @keyframes party-spin {
    to { --hue-angle: 360deg; }
  }
  @media (prefers-reduced-motion: reduce) {
    .party-frame.active { animation: none; }
  }
</style>
</head>
<body>
<iframe src="${URL}"></iframe>
<div class="qr">
  <img src="https://api.qrserver.com/v1/create-qr-code/?size=${QR_SIZE}x${QR_SIZE}&data=${ENCODED_URL}" alt="QR-Code">
</div>
<div class="party-frame ${PARTY_CLASS}"></div>
</body>
</html>
